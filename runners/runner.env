# Environment variables injected into job processes by the GH Actions runner.
# This file is copied to the runner's working dir as `.env` by install-macmini.sh.
# Values here are read once on runner startup and re-applied per job.
#
# PATH must include Homebrew (for git, gh, jq, uv, etc. installed via brew),
# /usr/local/bin (for tools installed via the Apple silver-shells), and the
# system defaults. Without an explicit PATH the runner inherits launchd's
# minimal PATH and can't find `docker`, `gh`, `uv`, etc.
PATH=/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# OrbStack's Docker socket lives at this path; without DOCKER_HOST set, the
# Docker CLI looks at /var/run/docker.sock which doesn't exist on macOS.
DOCKER_HOST=unix:///Users/apetresc/.orbstack/run/docker.sock
